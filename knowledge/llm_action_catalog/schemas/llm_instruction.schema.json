{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ares LLM action instruction",
  "type": "object",
  "additionalProperties": false,
  "required": ["actions"],
  "properties": {
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "args"],
        "properties": {
          "id": {"type": "string"},
          "args": {"type": "object"}
        }
      }
    }
  }
}

