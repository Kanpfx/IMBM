{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ares action catalog chapter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chapter", "source", "entries"],
  "properties": {
    "schema_version": {"type": "string"},
    "chapter": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "documentation_url": {"type": "string"}
      }
    },
    "source": {"type": "object"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "description",
          "documentation_status",
          "params"
        ],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "kind": {"type": "string"},
          "description": {"type": "string"},
          "documentation_status": {"type": "string"},
          "params": {"type": "array"}
        }
      }
    }
  }
}

