      "id": "api_reference.aresbot.do_unload_container",
      "name": "do_unload_container",
      "kind": "executable_command",
      "description": "Queue unloading one cargo item from a container after registered behaviors execute.",
      "documentation_status": "source_only_public",
      "api": {
        "import": "ares.main.AresBot",
        "member": "do_unload_container",
        "source_path": "ares-sc2/src/ares/main.py",
        "dispatch": "call_method"
      },
      "params": [
        {
          "name": "container_tag",
          "type": "integer",
          "input": "runtime",
          "required": true,
          "description": "Tag of the container to unload."
        },
        {
          "name": "index",
          "type": "integer",
          "input": "runtime",
          "required": false,
          "description": "Zero-based index of the cargo item to unload.",
          "default": 0
        }
      ],
      "parser": {
        "mode": "call_method"
      },
      "llm_exposure": "runtime_only"
    },
