{
  "schema_version": "1.0",
  "chapter": {
    "id": "behavior.group_combat",
    "title": "Group Combat Behaviors",
    "documentation_url": "https://aressc2.github.io/ares-sc2/api_reference/behaviors/group_combat_behaviors.html"
  },
  "source": {
    "ares_version": "3.9.6",
    "git_commit": "0ac34b87f9471979f8de19a77020eed2d8693b26"
  },
  "entries": [
    {
      "id": "combat.group.a_move_group",
      "name": "AMoveGroup",
      "kind": "executable_behavior",
      "description": "A-Move group to a target.",
      "documentation_status": "documented",
      "availability": {
        "mode": "bc_group",
        "actor_unit_types": ["MARINE", "BATTLECRUISER"],
        "minimum_actors": 2
      },
      "api": {
        "import": "ares.behaviors.combat.group.a_move_group.AMoveGroup",
        "source_path": "ares-sc2/src/ares/behaviors/combat/group/a_move_group.py",
        "dispatch": "register_behavior"
      },
      "params": [
        {
          "name": "group",
          "type": "unit_refs",
          "python_type": "list[Unit]",
          "input": "model",
          "required": true,
          "description": "Units we want to control."
        },
        {
          "name": "group_tags",
          "type": "integer_list",
          "python_type": "set[int]",
          "input": "derived",
          "required": true,
          "description": "The group unit tags."
        },
        {
          "name": "target",
          "type": "point_or_unit_ref",
          "python_type": "Union[Point2, Unit]",
          "input": "model",
          "required": true,
          "description": "Where the unit is going."
        }
      ],
      "parser": {
        "mode": "construct_and_register",
        "instruction_shape": "{id, args}"
      },
      "llm_exposure": "eligible"
    },
    {
      "id": "combat.group.group_use_ability",
      "name": "GroupUseAbility",
      "kind": "executable_behavior",
      "description": "Issue a single ability command for a group of units.",
      "documentation_status": "documented",
      "api": {
        "import": "ares.behaviors.combat.group.group_use_ability.GroupUseAbility",
        "source_path": "ares-sc2/src/ares/behaviors/combat/group/group_use_ability.py",
        "dispatch": "register_behavior"
      },
      "params": [
        {
          "name": "ability",
          "type": "ability_id",
          "python_type": "AbilityId",
          "input": "model",
          "required": true,
          "description": "Ability we want to use."
        },
        {
          "name": "group",
          "type": "unit_refs",
          "python_type": "list[Unit]",
          "input": "model",
          "required": true,
          "description": "Units we want to control."
        },
        {
          "name": "group_tags",
          "type": "integer_list",
          "python_type": "set[int]",
          "input": "derived",
          "required": true,
          "description": "The group unit tags."
        },
        {
          "name": "target",
          "type": "point_or_unit_ref",
          "python_type": "Union[Point2, Unit, None]",
          "input": "model",
          "required": true,
          "description": "The target for this ability."
        },
        {
          "name": "sync_command",
          "type": "boolean",
          "python_type": "bool",
          "input": "model",
          "required": false,
          "description": "(default=True) If True, wait for all units to be ready before trying ability.",
          "default": true
        }
      ],
      "parser": {
        "mode": "construct_and_register",
        "instruction_shape": "{id, args}"
      },
      "llm_exposure": "eligible"
    },
    {
      "id": "combat.group.keep_group_safe",
      "name": "KeepGroupSafe",
      "kind": "executable_behavior",
      "description": "Keep every unit in a group safe, optionally attacking a nearby enemy when its weapon is ready.",
      "documentation_status": "documented",
      "availability": {
        "mode": "bc_group",
        "actor_unit_types": ["MARINE", "BATTLECRUISER"],
        "minimum_actors": 2,
        "requires_enemy": true,
        "enemy_params": ["close_enemy"],
        "grid_params": ["grid"]
      },
      "api": {
        "import": "ares.behaviors.combat.group.keep_group_safe.KeepGroupSafe",
        "source_path": "ares-sc2/src/ares/behaviors/combat/group/keep_group_safe.py",
        "dispatch": "register_behavior"
      },
      "params": [
        {
          "name": "group",
          "type": "unit_refs",
          "python_type": "list[Unit]",
          "input": "model",
          "required": true,
          "description": "Units we want to control."
        },
        {
          "name": "close_enemy",
          "type": "unit_refs",
          "python_type": "Union[Units, list[Unit]]",
          "input": "model",
          "required": true,
          "description": "Nearby enemy."
        },
        {
          "name": "grid",
          "type": "grid_ref",
          "python_type": "np.ndarray",
          "input": "model",
          "required": true,
          "description": "Grid we should check for safety."
        },
        {
          "name": "attack_in_range_enemy",
          "type": "boolean",
          "python_type": "bool",
          "input": "model",
          "required": false,
          "description": "Whether to attack in range if weapon is ready. Defaults to True.",
          "default": true
        }
      ],
      "parser": {
        "mode": "construct_and_register",
        "instruction_shape": "{id, args}"
      },
      "llm_exposure": "eligible"
    },
    {
      "id": "combat.group.path_group_to_target",
      "name": "PathGroupToTarget",
      "kind": "executable_behavior",
      "description": "Path a group to its target destination.",
      "documentation_status": "documented",
      "availability": {
        "mode": "bc_group",
        "actor_unit_types": ["MARINE", "BATTLECRUISER"],
        "minimum_actors": 2,
        "grid_params": ["grid"]
      },
      "api": {
        "import": "ares.behaviors.combat.group.path_group_to_target.PathGroupToTarget",
        "source_path": "ares-sc2/src/ares/behaviors/combat/group/path_group_to_target.py",
        "dispatch": "register_behavior"
      },
      "params": [
        {
          "name": "start",
          "type": "point_ref",
          "python_type": "Point2",
          "input": "model",
          "required": true,
          "description": "Where to start the path query."
        },
        {
          "name": "group",
          "type": "unit_refs",
          "python_type": "list[Unit]",
          "input": "model",
          "required": true,
          "description": "The actual group units."
        },
        {
          "name": "group_tags",
          "type": "integer_list",
          "python_type": "set[int]",
          "input": "derived",
          "required": true,
          "description": "The units to path."
        },
        {
          "name": "grid",
          "type": "grid_ref",
          "python_type": "np.ndarray",
          "input": "model",
          "required": true,
          "description": "2D grid to path on."
        },
        {
          "name": "target",
          "type": "point_ref",
          "python_type": "Point2",
          "input": "model",
          "required": true,
          "description": "Target destination."
        },
        {
          "name": "distance_check_squared",
          "type": "number",
          "python_type": "float",
          "input": "model",
          "required": false,
          "description": "Distance check squared.",
          "default": 26.25
        },
        {
          "name": "success_at_distance",
          "type": "number",
          "python_type": "float",
          "input": "model",
          "required": false,
          "description": "If the group's supplied start position is this close to the target, do not issue a pathing command. Defaults to 0.0.",
          "default": 0.0
        },
        {
          "name": "sensitivity",
          "type": "integer",
          "python_type": "int",
          "input": "model",
          "required": false,
          "description": "Pathfinding precision. Defaults to 12.",
          "default": 12
        },
        {
          "name": "smoothing",
          "type": "boolean",
          "python_type": "bool",
          "input": "model",
          "required": false,
          "description": "Whether to smooth out the path. Defaults to False.",
          "default": false
        },
        {
          "name": "sense_danger",
          "type": "boolean",
          "python_type": "bool",
          "input": "model",
          "required": false,
          "description": "Whether to check for dangers. If none are present, the pathing query is skipped. Defaults to False.",
          "default": false
        },
        {
          "name": "danger_distance",
          "type": "number",
          "python_type": "float",
          "input": "model",
          "required": false,
          "description": "If `sense_danger` is True, how far to check for dangers. Defaults to 20.0.",
          "default": 20.0
        },
        {
          "name": "danger_threshold",
          "type": "number",
          "python_type": "float",
          "input": "model",
          "required": false,
          "description": "Influence at which a danger is respected. Defaults to 5.0.",
          "default": 5.0
        },
        {
          "name": "prevent_duplicate",
          "type": "boolean",
          "python_type": "bool",
          "input": "model",
          "required": false,
          "description": "Whether to try to prevent spamming actions. Defaults to True.",
          "default": true
        }
      ],
      "parser": {
        "mode": "construct_and_register",
        "instruction_shape": "{id, args}"
      },
      "llm_exposure": "eligible"
    },
    {
      "id": "combat.group.stutter_group_back",
      "name": "StutterGroupBack",
      "kind": "executable_behavior",
      "description": "Stutter a group back in unison.",
      "documentation_status": "documented",
      "api": {
        "import": "ares.behaviors.combat.group.stutter_group_back.StutterGroupBack",
        "source_path": "ares-sc2/src/ares/behaviors/combat/group/stutter_group_back.py",
        "dispatch": "register_behavior"
      },
      "params": [
        {
          "name": "group",
          "type": "unit_refs",
          "python_type": "list[Unit]",
          "input": "model",
          "required": true,
          "description": "The group of units we want to control."
        },
        {
          "name": "group_tags",
          "type": "integer_list",
          "python_type": "set[int]",
          "input": "derived",
          "required": true,
          "description": "The group unit tags."
        },
        {
          "name": "group_position",
          "type": "point_ref",
          "python_type": "Point2",
          "input": "model",
          "required": true,
          "description": "The position where this group is situated."
        },
        {
          "name": "target",
          "type": "point_or_unit_ref",
          "python_type": "Union[Point2, Unit]",
          "input": "model",
          "required": true,
          "description": "Target for the group."
        },
        {
          "name": "grid",
          "type": "grid_ref",
          "python_type": "np.ndarray",
          "input": "model",
          "required": true,
          "description": "Grid this group will use to path on."
        }
      ],
      "parser": {
        "mode": "construct_and_register",
        "instruction_shape": "{id, args}"
      },
      "llm_exposure": "eligible"
    },
    {
      "id": "combat.group.stutter_group_forward",
      "name": "StutterGroupForward",
      "kind": "executable_behavior",
      "description": "Stutter a group forward in unison.",
      "documentation_status": "documented",
      "api": {
        "import": "ares.behaviors.combat.group.stutter_group_forward.StutterGroupForward",
        "source_path": "ares-sc2/src/ares/behaviors/combat/group/stutter_group_forward.py",
        "dispatch": "register_behavior"
      },
      "params": [
        {
          "name": "group",
          "type": "unit_refs",
          "python_type": "list[Unit]",
          "input": "model",
          "required": true,
          "description": "The group of units we want to control."
        },
        {
          "name": "group_tags",
          "type": "integer_list",
          "python_type": "set[int]",
          "input": "derived",
          "required": true,
          "description": "The group unit tags."
        },
        {
          "name": "group_position",
          "type": "point_ref",
          "python_type": "Point2",
          "input": "model",
          "required": true,
          "description": "Accepted for API compatibility; currently ignored by the implementation."
        },
        {
          "name": "target",
          "type": "point_or_unit_ref",
          "python_type": "Union[Point2, Unit]",
          "input": "model",
          "required": true,
          "description": "Reference target used while coordinating the group. This behavior does nothing when no enemies are supplied."
        },
        {
          "name": "enemies",
          "type": "unit_refs",
          "python_type": "Union[Units, list[Unit]]",
          "input": "model",
          "required": true,
          "description": "The enemy units we want to stutter towards."
        }
      ],
      "parser": {
        "mode": "construct_and_register",
        "instruction_shape": "{id, args}"
      },
      "llm_exposure": "eligible"
    }
  ]
}
